{
  "name": "my-react-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/generate-service-worker.mjs",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint app scripts vite.config.ts react-router.config.ts && stylelint \"app/**/*.css\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "extract:questions": "node scripts/extract-driving-questions.mjs",
    "validate:questions": "node scripts/validate-driving-questions.mjs",
    "test": "node scripts/test-quiz-integrity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.3"
  }
}
